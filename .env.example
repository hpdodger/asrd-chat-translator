# ── Docker Compose ────────────────────────────────────────────────────────────

# Путь к папке скриптов игры НА ХОСТЕ (монтируется в контейнер как /gamedata)
# Windows: D:\soft\Steam\steamapps\common\Alien Swarm Reactive Drop\reactivedrop\save\vscripts
# Linux:   /home/steam/steamapps/common/Alien Swarm Reactive Drop/reactivedrop/save/vscripts
HOST_GAME_DATA_PATH=D:\soft\Steam\steamapps\common\Alien Swarm Reactive Drop\reactivedrop\save\vscripts

# Языки LibreTranslate (через запятую, ISO 639-1).
# Меньше языков = быстрее старт и меньше RAM.
# en обязателен — используется как fallback если запрошенный язык недоступен.
LT_LOAD_ONLY=en,ru

# API ключ LibreTranslate (оставить пустым если сервер без авторизации)
LIBRETRANSLATE_API_KEY=
